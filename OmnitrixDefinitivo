		InvisToggle.TextSize = 16
		InvisToggle.TextScaled = true
		InvisToggle.ZIndex = 6
		Instance.new("UICorner", InvisToggle).CornerRadius = UDim.new(0, 6)
		
		-- Noclip constante para atravessar paredes
		local noclipLoop = RunService.Stepped:Connect(function()
			if char then
				for _, part in pairs(char:GetChildren()) do
					if part:IsA("BasePart") then part.CanCollide = false end
				end
			end
		end)
		table.insert(activeLoops, noclipLoop)

		local isInvis = false
		local cameraOffsetLoop = nil
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local standingGyro = nil

		InvisToggle.MouseButton1Click:Connect(function()
			if not char or not hum or not hrp then return end

			if not isInvis then
				if hum.FloorMaterial ~= Enum.Material.Air then
					isInvis = true
					InvisToggle.Text = "Modo Invisivel: ON"
					targetSpeed = 100

					-- Cria Gyro para manter em pé sempre
					standingGyro = Instance.new("BodyGyro")
					standingGyro.Name = "FriagemStandingGyro"
					standingGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
					standingGyro.P = 50000
					standingGyro.CFrame = hrp.CFrame
					standingGyro.Parent = hrp

					hrp.CFrame = hrp.CFrame * CFrame.new(0, -20, 0)

					local bv = Instance.new("BodyVelocity")
					bv.Name = "InvisAntiVoid"
					bv.MaxForce = Vector3.new(0, math.huge, 0)
					bv.Velocity = Vector3.new(0, 0, 0)
					bv.Parent = hrp

					cameraOffsetLoop = RunService.RenderStepped:Connect(function()
						if hrp and hum then
							hrp.Position = Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
							hum.CameraOffset = Vector3.new(0, 20, 0)

							local _, camY, _ = workspace.CurrentCamera.CFrame:ToOrientation()
							standingGyro.CFrame = CFrame.fromOrientation(0, camY, 0)
						end
					end)
				end
			else
				isInvis = false
				InvisToggle.Text = "Modo Invisivel: OFF"
				targetSpeed = 20

				if cameraOffsetLoop then
					cameraOffsetLoop:Disconnect()
					cameraOffsetLoop = nil
				end

				if hrp:FindFirstChild("InvisAntiVoid") then hrp.InvisAntiVoid:Destroy() end

				task.delay(1, function()
					if standingGyro then standingGyro:Destroy() end
				end)

				hum.CameraOffset = Vector3.new(0, 0, 0)
				hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 20, hrp.Position.Z)
			end
		end)

		table.insert(activeLoops, {Disconnect = function()
			InvisToggle:Destroy()
			if cameraOffsetLoop then cameraOffsetLoop:Disconnect() end
			if standingGyro then standingGyro:Destroy() end
			if hrp and hrp:FindFirstChild("InvisAntiVoid") then hrp.InvisAntiVoid:Destroy() end
			if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end
		end})

		local friagemSpeedConn = RunService.Heartbeat:Connect(function()
			if hum and hum.Parent then
				local currentMax = isInvis and 100 or (hum.FloorMaterial == Enum.Material.Air and (targetSpeed * 5) or targetSpeed)
				if hum.WalkSpeed ~= currentMax then hum.WalkSpeed = currentMax end
				if hum.JumpPower ~= targetJump then hum.JumpPower = targetJump end
				if not hum.UseJumpPower then hum.UseJumpPower = true end
