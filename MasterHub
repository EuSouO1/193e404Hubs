local function refreshRocks()
	for _, child in pairs(rockScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	-- Usando o RockRegistry em vez de buscar no workspace inteiro
	for name, path in pairs(RockRegistry) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 25)
		btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		btn.Font = Enum.Font.Gotham
		btn.Text = name
		btn.TextColor3 = Color3.fromRGB(200, 200, 200)
		btn.TextSize = 12
		btn.Parent = rockScroll

		btn.MouseButton1Click:Connect(function()
			local part = getPartFromPath(path)
			if part then
				selectedRock = part
				rockOriginalCFrame = part.CFrame
				rockOriginalSize = part.Size
				titleLabel.Text = "Rock Selecionada!"
				task.delay(1, function() titleLabel.Text = "Master Hub" end)
			else
				titleLabel.Text = "Rock Não Encontrada!"
				task.delay(1, function() titleLabel.Text = "Master Hub" end)
			end
		end)
	end
end

