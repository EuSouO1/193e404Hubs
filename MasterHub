-- Função auxiliar para buscar a pedra pelo caminho
local function getPartFromPath(path)
	local obj = Workspace
	for partName in string.gmatch(path, "[^.]+") do
		obj = obj:FindFirstChild(partName)
		if not obj then return nil end
	end
	return obj
end

