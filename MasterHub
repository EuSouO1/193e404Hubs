--// LOOP PRINCIPAL DE EXECUÇÃO (Heartbeat)
RunService.Heartbeat:Connect(function()
	local char = player.Character
	if not char then return end
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")

	-- Processamento de Auto Farm
	if activeFeature == "AutoWeight" then
		useToolRoutine("Weight")
	elseif activeFeature == "AutoPushups" then
		useToolRoutine("Pushups")
	elseif activeFeature == "AutoPunch" then
		useToolRoutine("Punch")
	elseif activeFeature == "AutoRock" and selectedRock then
		local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or rootPart
		if torso then
			selectedRock.CanCollide = false
			selectedRock.Anchored = true
			selectedRock.Size = Vector3.new(0.1, 0.1, 0.1)
			-- Agora a pedra fica posicionada a 2 studs na sua frente
			selectedRock.CFrame = torso.CFrame * CFrame.new(0, -0.2, -2.25) 
		end

		-- Processamento de Kill Player
	elseif activeFeature == "KillPlayer" and selectedTarget and rootPart then
		useToolRoutine("Punch")
		local targetChar = selectedTarget.Character
		if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
			local tRoot = targetChar.HumanoidRootPart
			local bv = rootPart:FindFirstChild("HubBodyVelocity") or Instance.new("BodyVelocity")
			bv.Name = "HubBodyVelocity"
			bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bv.Velocity = (tRoot.Position - (tRoot.CFrame.LookVector * 5) - rootPart.Position) * 10
			bv.Parent = rootPart
		end

		-- Processamento de Kill All
	elseif activeFeature == "KillAll" and rootPart then
		useToolRoutine("Punch")
		local targetP = nil
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChildOfClass("Humanoid") then
				if p.Character.Humanoid.Health > 0 then
					targetP = p
					break
				end
			end
		end
		if targetP and targetP.Character and targetP.Character:FindFirstChild("HumanoidRootPart") then
			local tRoot = targetP.Character.HumanoidRootPart
			local bv = rootPart:FindFirstChild("HubBodyVelocity") or Instance.new("BodyVelocity")
			bv.Name = "HubBodyVelocity"
			bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bv.Velocity = (tRoot.Position - (tRoot.CFrame.LookVector * 5) - rootPart.Position) * 10
			bv.Parent = rootPart
		end
	else
		-- Remove BodyVelocity caso nenhuma função de kill esteja ativa
		if rootPart and rootPart:FindFirstChild("HubBodyVelocity") then
			rootPart.HubBodyVelocity:Destroy()
		end
	end
end)
