-- Função para registrar os cliques do combo
local function registerComboClick(arrow)
	local now = os.clock()
	if now - lastComboClickTime > 5 then comboHistory = "" end
	lastComboClickTime = now
	comboHistory = comboHistory .. arrow

	-- === LÓGICA DE ESCANEAMENTO (DNA SCAN) ===
	if comboHistory:sub(-10) == ">>><<<><><" then
		comboHistory = "" 

		if omnitrixCooldown then return end

		task.spawn(function()
			omnitrixCooldown = true -- Trava aqui

			local corOriginal = MainPanel.BackgroundColor3
			MainPanel.BackgroundColor3 = CORES_PAINEL.DnaDetec 
			pcall(function() playSound(IDS.Sons.Ligando) end)

			-- Bloco de processamento protegido
			local sucesso, erro = pcall(function()
				task.wait(3) 

				local hrp = lplayer.Character and lplayer.Character:FindFirstChild("HumanoidRootPart")
				local encontrado = nil

				if hrp then
					for _, v in pairs(workspace:GetDescendants()) do
						-- Verificação segura
						if v:IsA("Humanoid") and v.Parent and v.Parent ~= lplayer.Character then
							local root = v.Parent:FindFirstChild("HumanoidRootPart")
							local head = v.Parent:FindFirstChild("Head") -- Precisamos da cabeça

							if root then
								local dist = (root.Position - hrp.Position).Magnitude
								if dist <= 25 then
									local nomeDetectado = v.Parent.Name -- Nome padrão

									-- Tenta achar o nome na NameGui da cabeça
									if head and head:FindFirstChild("NameGui") then
										local gui = head.NameGui:FindFirstChild("TextBox")
										if gui and gui:IsA("TextBox") and gui.Text ~= "" then
											nomeDetectado = gui.Text -- Sobrescreve com o nome da TextBox
										end
									end

									-- Compara o nome detectado com a lista de aliens
									for _, a in ipairs(AliensDesbloqueaveis) do
										if string.find(string.lower(nomeDetectado), string.lower(a.Nome)) then
											encontrado = a
											break
										end
									end
								end
							end
						end
					end
				end

				if encontrado then
					local jaPossui = false
					for _, s in ipairs(IDS.Silhuetas) do 
						if s.Nome == encontrado.Nome then jaPossui = true break end 
					end

					if not jaPossui then
						table.insert(IDS.Silhuetas, encontrado)
					end
				end
			end)

			if not sucesso then warn("Erro no scan: " .. tostring(erro)) end

			-- GARANTIA: Isso aqui roda aconteça o que acontecer
			pcall(function() playSound(IDS.Sons.Ligando) end)
			MainPanel.BackgroundColor3 = corOriginal
			omnitrixCooldown = false -- Destrava aqui, aconteça o que acontecer
		end)
	end

	-- === LÓGICA DE CONTROLE MESTRE ===
	if comboHistory:sub(-30) == "><>><<<>>><<<<>>><><>><<<>>><<<" then
		comboHistory = ""
		masterControlActive = true
		MainPanel.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
		pcall(function() playSound(IDS.Sons.Carregado) end)
		if isTransformed then
			SelectionPanel.Visible = true
			OmnitrixBtn.Visible = false
		end
	end
end

OmnitrixBtn.MouseButton1Click:Connect(function()
	if omnitrixCooldown == true then return end

	-- 1. Lógica de Evolução Suprema
	if isTransformed then
		local alienAtual = currentAlienActive
		local ehSupremo = string.find(alienAtual, "Supremo")

		-- Se já for supremo, destransforma normal
		if ehSupremo then
			transform(nil)
			OmnitrixBtn.Visible = true
			EstaSupremo = false
			return
		end

		-- Se estiver transformado num alien que tem supremo e NÃO é supremo
		if Supremos[alienAtual] then
			local nomeSupremo = alienAtual .. " Supremo"

			-- Usa o shoutInChat como solicitado (já coloca maiúsculo e !)
			shoutInChat(nomeSupremo)

			-- Aplica a nova forma
			currentAlienActive = nomeSupremo
			applyAlienPowers(nomeSupremo)
			EstaSupremo = true
			return
		end

		-- Se não for nenhum dos casos acima, apenas destransforma
		transform(nil)
		OmnitrixBtn.Visible = true
		EstaSupremo = false
		return
	end

	-- 2. Se não estiver transformado, alterna o estado do menu (código original)
	isOmnitrixOn = not isOmnitrixOn

	if isOmnitrixOn then
		pcall(function() playSound(IDS.Sons.Ligando) end)
		SelectionPanel.Visible = true
		OmnitrixBtn.Visible = false
		updateSilhouette()
	else
		SelectionPanel.Visible = false
		OmnitrixBtn.Visible = true
	end
end)

