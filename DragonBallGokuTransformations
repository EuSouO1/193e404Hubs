local function CriarSom(nome, id, loopear)
	local sound = Instance.new("Sound")
	sound.Name = nome
	sound.SoundId = id
	sound.Looped = loopear or false
	sound.Volume = 1
	sound.Parent = SoundHolder
	return sound
end

