-- Sistema de Energia (Loop)
local TickRegen = 0
local TickDrain = 0

RunService.Heartbeat:Connect(function(dt)
	Energia = math.clamp(Energia, 0, 100)
	EnergyFill.Size = UDim2.new(Energia/100, 0, 1, 0)
	EnergyText.Text = "Energia: " .. Energia .. " | Form: " .. TransformacaoAtual

	if TransformacaoAtual == "Base" then
		TickRegen = TickRegen + dt
		if TickRegen >= 2 then
			TickRegen = 0
			if Energia < 100 then Energia = Energia + 1 end
		end
	else
		local formInfo = Forms[TransformacaoAtual]
		if formInfo then
			TickDrain = TickDrain + dt
			if TickDrain >= formInfo.drain then
				TickDrain = 0
				Energia = Energia - 1
				if Energia <= 0 then
					Destransformar()
				end
			end
		end
	end
end)

-- Sistema de Voo
UserInputService.JumpRequest:Connect(function()
	if VooAtivado then
		local char = Player.Character
		if char and char:FindFirstChildOfClass("Humanoid") then
			char:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

RunService.RenderStepped:Connect(function()
	local char = Player.Character
	if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
		local hum = char:FindFirstChildOfClass("Humanoid")
		local formSpeed = Forms[TransformacaoAtual].speed

		if VooAtivado and hum.FloorMaterial == Enum.Material.Air then
			hum.WalkSpeed = formSpeed * 5
			Workspace.Gravity = 196.2 / 3
		else
			hum.WalkSpeed = formSpeed
			Workspace.Gravity = 196.2
		end
	end
end)

local function ToggleVoo()
	VooAtivado = not VooAtivado
	BtnVoo.Text = VooAtivado and "Voo: ON" or "Voo: OFF"
	SomVooToggle:Play()
	if not VooAtivado then
		Workspace.Gravity = 196.2
	end
	AtualizarTextoAtalhos()
end
BtnVoo.MouseButton1Click:Connect(ToggleVoo)

-- Lógica de Transformação
function AplicarEfeitoVisual(formName)
	local dados = Forms[formName]
	if formName == "Base" then
		ColorEffect.Enabled = false
		if TweenPulse then TweenPulse:Cancel() end
		SomLoopForm:Stop()
	else
		ColorEffect.Enabled = true
		ColorEffect.TintColor = dados.color
		ColorEffect.Brightness = 0

		if TweenPulse then TweenPulse:Cancel() end

		local info = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		TweenPulse = TweenService:Create(ColorEffect, info, {Brightness = dados.intensity})
		TweenPulse:Play()

		if not SomLoopForm.IsPlaying then
			SomLoopForm:Play()
		end
	end
end

function Transformar()
	local antTrans = TransformacaoAtual
	if Energia >= 100 then
		TransformacaoAtual = "SSJ3"
	elseif Energia >= 75 then
		TransformacaoAtual = "SSJ2"
	elseif Energia >= 50 then
		TransformacaoAtual = "SSJ1"
	elseif Energia >= 25 then
		TransformacaoAtual = "Kaioken"
	else
		return
	end

	if antTrans == "Base" then
		SomTransformar:Play()
	end

	AplicarEfeitoVisual(TransformacaoAtual)
end

function Destransformar()
	TransformacaoAtual = "Base"
	AplicarEfeitoVisual("Base")
end

BtnTransformar.MouseButton1Click:Connect(Transformar)
BtnDestransformar.MouseButton1Click:Connect(Destransformar)

-- Habilidade de Impulso
function UsarImpulso()
	if ImpulsoCooldown then return end

	local char = Player.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local hrp = char.HumanoidRootPart
		ImpulsoCooldown = true
		BtnImpulso.Text = "Impulso (CD)"
		AtualizarTextoAtalhos()

		SomImpulso:Play()

		local velMagnitude = Forms[TransformacaoAtual].impulsoSpeed

		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = (hrp.CFrame.LookVector * velMagnitude) + Vector3.new(0, 25, 0)
		bv.Parent = hrp

		task.delay(0.1, function()
			if bv then bv:Destroy() end
		end)

		task.delay(3, function()
			ImpulsoCooldown = false
			BtnImpulso.Text = "Impulso"
			AtualizarTextoAtalhos()
		end)
	end
end
BtnImpulso.MouseButton1Click:Connect(UsarImpulso)

-- Lógica de Teleporte
BtnTeleporte.MouseButton1Click:Connect(function()
	if not TeleportCooldown then
		AguardandoTeleporte = true
		BtnTeleporte.Text = "Mirando..."
		AtualizarTextoAtalhos()
	end
end)

Mouse.Button1Down:Connect(function()
	if AguardandoTeleporte then
		AguardandoTeleporte = false
		BtnTeleporte.Text = "Teleporte (Mirar)"
		AtualizarTextoAtalhos()

		local char = Player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hrp = char.HumanoidRootPart
			local targetPos = Mouse.Hit.Position
			local dist = (hrp.Position - targetPos).Magnitude
			local maxDist = 25 + Forms[TransformacaoAtual].tpBonus

			if dist <= maxDist then
				hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
				SomTeleporte:Play()
				TeleportCooldown = true
				task.delay(0.2, function() TeleportCooldown = false end)
			end
		end
	end
end)

-- Sistema de Atalhos Dinâmicos (Limite de 5)
function AtualizarTextoAtalhos()
	for _, btn in pairs(ContainerAtalhos:GetChildren()) do
		if btn:IsA("TextButton") then
			if btn.Name == "Voo" then
				btn.Text = VooAtivado and "Voo: ON" or "Voo: OFF"
			elseif btn.Name == "Teleporte" then
				btn.Text = AguardandoTeleporte and "Mirando..." or "Teleporte"
			elseif btn.Name == "Impulso" then
				btn.Text = ImpulsoCooldown and "Impulso (CD)" or "Impulso"
			end
		end
	end
end

function AdicionarRemoverAtalho(nome)
	if ContainerAtalhos:FindFirstChild(nome) then
		ContainerAtalhos:FindFirstChild(nome):Destroy()
		for i, v in ipairs(AtalhosAtivos) do
			if v == nome then table.remove(AtalhosAtivos, i) break end
		end
		return
	end

	if #AtalhosAtivos >= 5 then return end

	table.insert(AtalhosAtivos, nome)
	local btnAtalho = CriarBotaoMenu(nome, nome, ContainerAtalhos)

	if nome == "Voo" then btnAtalho.Text = VooAtivado and "Voo: ON" or "Voo: OFF"
	elseif nome == "Impulso" then btnAtalho.Text = ImpulsoCooldown and "Impulso (CD)" or "Impulso" end

	btnAtalho.MouseButton1Click:Connect(function()
		if nome == "Voo" then ToggleVoo()
		elseif nome == "Transformar" then Transformar()
		elseif nome == "Destransformar" then Destransformar()
		elseif nome == "Teleporte" then
			if not TeleportCooldown then
				AguardandoTeleporte = true
				btnAtalho.Text = "Mirando..."
			end
		elseif nome == "Impulso" then
			UsarImpulso()
		end
	end)
end
